# Cloudflare Tunnel Token
# Get this from: Cloudflare Dashboard > Zero Trust > Access > Tunnels
TUNNEL_TOKEN=your-tunnel-token-here

# Admin panel credentials (HTTP basic auth / token)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# mongo-express basic auth (UI bound to localhost only)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me

# MinIO root credentials — also used by gigi-server as access/secret key
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me

# Optional
# GIPHY_API_KEY=
# PLAY_PACKAGE_NAME=com.aman.gigi
# OTP_DEV_MODE=false   # NEVER leave true in production — true echoes the OTP in API responses
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}  # JSON; preferred over baking serviceAccountKey.json into the image
